<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="48dp">
  <LinearLayout android:id="@+id/ffb_notification_panel"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/ffb_notification_neutral_panel"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingHorizontal="10dp" android:paddingVertical="4dp">
    <ImageView android:id="@+id/ffb_notification_icon"
      android:layout_width="24dp" android:layout_height="24dp"
      android:layout_marginEnd="8dp" android:importantForAccessibility="no"
      android:src="@drawable/ffb_notification_balance" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
      android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/ffb_notification_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" android:fontFamily="sans-serif-medium"
        android:textColor="@color/ffb_notification_text"
        android:maxLines="1" android:ellipsize="end" />
      <TextView android:id="@+id/ffb_notification_body"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/ffb_notification_secondary"
        android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
