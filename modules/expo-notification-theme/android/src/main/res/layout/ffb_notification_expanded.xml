<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="wrap_content">
  <LinearLayout android:id="@+id/ffb_notification_panel"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/ffb_notification_neutral_panel"
    android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:id="@+id/ffb_notification_heading"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical"
      android:layout_marginBottom="4dp" android:visibility="gone">
      <ImageView android:id="@+id/ffb_notification_icon"
        android:layout_width="18dp" android:layout_height="18dp"
        android:layout_marginEnd="6dp" android:importantForAccessibility="no"
        android:src="@drawable/ffb_notification_balance" />
      <TextView android:id="@+id/ffb_notification_direction"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:fontFamily="sans-serif-medium"
        android:textColor="@color/ffb_notification_brand_ink"
        android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/ffb_notification_title"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textSize="20sp" android:fontFamily="sans-serif-medium"
      android:textColor="@color/ffb_notification_text"
      android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/ffb_notification_body"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="4dp" android:textSize="14sp"
      android:textColor="@color/ffb_notification_secondary"
      android:maxLines="3" android:ellipsize="end" />
  </LinearLayout>
</FrameLayout>
