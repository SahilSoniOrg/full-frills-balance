+        // A native TabView otherwise wins against enclosing RNGH pans before
+        // their direction/edge constraints resolve (for example, a drawer).
+        // Wait until handlers are attached before establishing UIKit priority.
+        DispatchQueue.main.async { [weak collectionView] in
+          guard let collectionView,
+                let handlerPanClass = NSClassFromString("RNBetterPanGestureRecognizer") else { return }
+          var ancestor = collectionView.superview
+          while let view = ancestor {
+            for recognizer in view.gestureRecognizers ?? [] {
+              if recognizer.isKind(of: handlerPanClass) {
+                collectionView.panGestureRecognizer.require(toFail: recognizer)
+              }
+            }
+            ancestor = view.superview
+          }
+        }
+
