<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_safe_to_spend_actions_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_journal_launcher_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/widget_safe_to_spend_actions_content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_safe_to_spend_actions_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/safe_to_spend_widget_title"
            android:textAllCaps="true"
            android:textColor="#B8D6EB"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_safe_to_spend_actions_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="@string/safe_to_spend_widget_amount_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_safe_to_spend_actions_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:text="@string/safe_to_spend_widget_subtitle"
            android:textColor="#D9EAF6"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="160dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/widget_safe_to_spend_actions_income_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_action_income_circle"
                android:foregroundGravity="center">

                <ImageView
                    android:id="@+id/widget_safe_to_spend_actions_income_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/journal_widget_income"
                    android:src="@drawable/widget_journal_launcher_income" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_safe_to_spend_actions_income_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/journal_widget_income"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/widget_safe_to_spend_actions_expense_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_action_expense_circle"
                android:foregroundGravity="center">

                <ImageView
                    android:id="@+id/widget_safe_to_spend_actions_expense_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/journal_widget_expense"
                    android:src="@drawable/widget_journal_launcher_expense" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_safe_to_spend_actions_expense_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/journal_widget_expense"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/widget_safe_to_spend_actions_transfer_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_action_transfer_circle"
                android:foregroundGravity="center">

                <ImageView
                    android:id="@+id/widget_safe_to_spend_actions_transfer_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/journal_widget_transfer"
                    android:src="@drawable/widget_journal_launcher_transfer" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_safe_to_spend_actions_transfer_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/journal_widget_transfer"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
