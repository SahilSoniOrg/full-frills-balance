# Copy to `.env.local` (gitignored). All values are optional for local dev;
# without them the app runs, but analytics, crash reporting, and AI downloads are limited.

# WARNING: EXPO_PUBLIC_* values are embedded in the client bundle — not for secrets.

EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_VARIANT=development

# Build-time only (EAS / source maps) — do NOT use EXPO_PUBLIC_ prefix
SENTRY_AUTH_TOKEN=

# Optional: Hugging Face token for on-device model download
EXPO_PUBLIC_HF_TOKEN=
