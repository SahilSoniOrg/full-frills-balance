# Copy to `.env.local` (gitignored). All values are optional for local dev;
# without them the app runs, but analytics and crash reporting are limited.

# WARNING: Any EXPO_PUBLIC_* variable is compiled into the client bundle and visible
# in the shipped app. Use EXPO_PUBLIC_ only for non-secret config (analytics DSN/key, host).

EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_VARIANT=development

# TypeSafe is configured in the backend environment, never in the app bundle.
# Keep this value server-side and out of source control.
TYPESAFE_API_KEY=
EXPO_PUBLIC_TYPESAFE_PROXY_URL=http://127.0.0.1:8787
TYPESAFE_PROXY_PORT=8787
TYPESAFE_PROXY_HOST=127.0.0.1
TYPESAFE_ALLOWED_ORIGINS=http://127.0.0.1:8081
TYPESAFE_DEBUG_LOGS=1

# Build-time / CI only — never prefix with EXPO_PUBLIC_ (would leak into the bundle)
SENTRY_AUTH_TOKEN=
