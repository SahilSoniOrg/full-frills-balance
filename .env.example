# Copy to `.env.local` (gitignored). All values are optional for local dev;
# without them the app runs, but analytics and crash reporting are limited.

# WARNING: Any EXPO_PUBLIC_* variable is compiled into the client bundle and visible
# in the shipped app. Use EXPO_PUBLIC_ only for non-secret config (analytics DSN/key, host).

EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN_DEVELOPMENT=
EXPO_PUBLIC_SENTRY_DSN_PREVIEW=
EXPO_PUBLIC_SENTRY_DSN_PRODUCTION=
EXPO_PUBLIC_APP_VARIANT=development
# Set to 1 to enable both PostHog and Sentry in development builds (off by default).
EXPO_PUBLIC_ENABLE_ANALYTICS_IN_DEV=0

# Gmail capture (compiled into the client). Create OAuth clients in Google Cloud for
# each app id (production / preview / development) and enable the Gmail API.
# Web client ID is required on Android + iOS; iOS client ID is required on iOS
# (also drives the reversed-client URL scheme in app.config.ts).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Build-time / CI only — never prefix with EXPO_PUBLIC_ (would leak into the bundle)
SENTRY_AUTH_TOKEN=
