<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/direction" android:layout_width="32dp" android:layout_height="wrap_content" android:text="↗" android:textSize="23sp" android:textColor="@color/preview_coral" />
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/preview_text" android:maxLines="1" />
    <TextView android:id="@+id/merchant" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/preview_secondary" android:maxLines="1" />
  </LinearLayout>
</LinearLayout>
