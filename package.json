{
  "name": "full-frills-balance",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "node scripts/run-android.mjs development",
    "android:preview": "node scripts/run-android.mjs preview",
    "android:release": "node scripts/run-android.mjs production",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "node scripts/check-service-database-access.mjs && tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "check:unsafe-types": "node scripts/check-unsafe-type-ratchet.mjs",
    "check:journal-facade": "node scripts/check-journal-repository-facade.mjs",
    "check:read-boundaries": "node scripts/check-read-boundaries.mjs",
    "check:feature-boundaries": "node --test scripts/__tests__/check-feature-boundaries.test.mjs && node scripts/check-feature-boundaries.mjs",
    "check:dependency-cycles": "node scripts/check-dependency-cycles.mjs",
    "check:privacy-policy": "node scripts/check-privacy-policy-version.mjs",
    "check:architecture-ratchets": "node --test scripts/__tests__/check-architecture-ratchets.test.mjs && node scripts/check-architecture-ratchets.mjs",
    "check:service-database-access": "node scripts/check-service-database-access.mjs",
    "check:branded-casts": "node --test scripts/__tests__/check-redundant-branded-casts.test.mjs && node scripts/check-redundant-branded-casts.mjs",
    "check:architecture": "bun run check:unsafe-types && bun run check:journal-facade && bun run check:read-boundaries && bun run check:feature-boundaries && bun run check:dependency-cycles && bun run check:architecture-ratchets && bun run check:branded-casts && bun run typecheck:e2e",
    "verify": "bun run check:architecture && bun run check:privacy-policy && bun run typecheck && bun run test:typesafe:proxy && bun run test:ci && bun run lint",
    "test": "jest",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:build": "expo export -p web --output-dir dist-e2e",
    "serve:e2e": "serve dist-e2e -p 8081 --single",
    "e2e:build:ios": "EXPO_PUBLIC_E2E=1 detox build --configuration ios.sim.release",
    "e2e:test:ios": "detox test --configuration ios.sim.release e2e/specs",
    "e2e:test:ios:device": "test -n \"$DETOX_IOS_DEVICE_UDID\" || { echo 'Set DETOX_IOS_DEVICE_UDID first'; exit 1; }; detox test --configuration ios.device.release e2e/specs",
    "e2e:ci": "EXPO_PUBLIC_E2E=1 detox test --configuration ios.sim.release e2e/specs --runInBand",
    "e2e:clean:ios": "bash scripts/e2e-clean-ios.sh",
    "e2e:build:android": "EXPO_PUBLIC_E2E=1 detox build --configuration android.emu.release",
    "e2e:test:android": "detox test --configuration android.emu.release e2e/specs",
    "e2e:test:android:device": "test -n \"$DETOX_ANDROID_DEVICE_ID\" || { echo 'Set DETOX_ANDROID_DEVICE_ID first'; exit 1; }; detox test --configuration android.device.release e2e/specs",
    "e2e:maestro": "maestro test .maestro",
    "check:production-e2e-bundle": "APP_VARIANT=production EXPO_PUBLIC_E2E=0 expo export --platform android --output-dir dist/production-e2e-check && node scripts/check-e2e-bundle.mjs dist/production-e2e-check",
    "e2e:local": "bash scripts/e2e-local.sh",
    "test:detox:build": "bun run e2e:build:ios",
    "test:detox:video": "DETOX_RECORD_VIDEO=1 detox test --configuration ios.sim.release --record-videos all --take-screenshots all",
    "prepare": "husky",
    "visualize": "expo export --platform android --source-maps --no-bytecode --output-dir dist-analysis && source-map-explorer dist-analysis/_expo/static/js/android/*.js dist-analysis/_expo/static/js/android/*.js.map --no-border-checks",
    "typesafe:proxy": "node --env-file-if-exists=.env.local scripts/typesafe-proxy.mjs",
    "test:typesafe:proxy": "node --test scripts/__tests__/typesafe-proxy.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/crimson-text": "^0.4.0",
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/raleway": "^0.4.2",
    "@lovesworking/watermelondb-expo-plugin-sdk-52-plus": "^1.0.3",
    "@nozbe/watermelondb": "^0.28.1-0",
    "@posthog/react-native-plugin": "^2.9.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.3.2",
    "babel-plugin-react-compiler": "^19.0.0-beta-ebf51a3-20250411",
    "d3-sankey": "^0.12.3",
    "dayjs": "^1.11.23",
    "expo": "~57.0.22",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-screen-capture": "~57.0.3",
    "expo-sharing": "~57.0.19",
    "expo-speech-recognition": "~57.0.0",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "fflate": "^0.8.3",
    "lucide-react-native": "^0.563.0",
    "moti": "^0.30.0",
    "posthog-react-native": "^4.72.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-quick-crypto": "^1.1.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "react-native-zip-archive": "9.5.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@react-native-community/cli": "20.2.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/jest": "29.5.14",
    "@types/node": "^25.9.5",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-import": "^1.13.8",
    "detox": "20.51.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "expo-detox-config-plugin": "^13.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "react-native-launch-arguments": "^4.1.1",
    "react-test-renderer": "19.2.3",
    "serve": "^14.2.6",
    "sharp": "^0.35.4",
    "source-map-explorer": "^2.5.3",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson",
          "expo-sms-inbox",
          "react-native-launch-arguments"
        ]
      }
    }
  }
}
